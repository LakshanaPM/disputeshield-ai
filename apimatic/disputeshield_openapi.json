{
  "openapi": "3.1.0",
  "info": {
    "title": "DisputeShield AI API",
    "description": "DisputeShield AI: Autonomous dispute defense agent for PayPal merchants. Provides REST endpoints for dispute triage, evidence generation, risk analytics, and webhook ingestion. Standardized OpenAPI 3.0 specification formatted for APIMatic SDK generation.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/webhooks/paypal": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Receive Paypal Webhook",
        "description": "Receive and process PayPal webhook events.\n\nFlow:\n1. Parse the raw payload\n2. Verify webhook signature via verify_paypal_webhook\n3. Check idempotency (return already_processed if exists)\n4. Store raw event in database\n5. Enqueue Celery task (process_dispute_webhook)\n6. Return 200 within 200ms",
        "operationId": "receive_paypal_webhook_api_webhooks_paypal_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/webhooks/paypal/simulate": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Simulate Paypal Webhook",
        "description": "Simulate incoming PayPal webhook for live hackathon demos.\nRotates through realistic dispute scenarios to demonstrate both\nAUTO_SUBMITTED (hands-free) and DRAFT_PENDING_REVIEW (requires review).",
        "operationId": "simulate_paypal_webhook_api_webhooks_paypal_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulateWebhookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
