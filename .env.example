# ============================================================
# DisputeShield AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- PayPal Sandbox Credentials ---
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# --- PostgreSQL ---
DATABASE_URL=postgresql://disputeshield:disputeshield@localhost:5432/disputeshield

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_DISPUTES=disputes
ELASTICSEARCH_INDEX_VECTORS=dispute_vectors

# --- Redis (Celery Broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret-key

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_AG_GRID_LICENSE_KEY=your_ag_grid_enterprise_license_key_here

# --- Agent Configuration ---
AGENT_AUTO_SUBMIT_THRESHOLD=80
AGENT_DRAFT_THRESHOLD=60
AGENT_MAX_SUBMISSIONS_PER_MINUTE=10
